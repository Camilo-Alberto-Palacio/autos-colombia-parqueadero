@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 6
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam ArrowColor #2C3E50
skinparam ArrowFontColor #1E293B
skinparam ClassBackgroundColor #FFFBEB
skinparam ClassHeaderBackgroundColor #FEF3C7
skinparam ClassBorderColor #B45309

skinparam nodesep 28
skinparam ranksep 38
title Diagrama de Clases del Dominio Integrado (9 Entidades + RBAC) — Iteración 3 (Gestión de Pagos)

class Usuario {
  + id : int <<PK>>
  + username : str <<unique>>
  - password_hash : str [SHA-256]
  + nombre_completo : str
  + email : str <<unique>>
  + rol : Enum(ADMIN, OPERARIO, AUDITOR)
  + activo : bool
  --
  + autenticar_usuario(username, password) : dict
  + crear_usuario(datos, admin_id) : dict
  + actualizar_usuario(user_id, datos, admin_id) : dict
  + eliminar_usuario(user_id, admin_id) : dict
}

class VerificadorRBAC <<service>> {
  + PERMISOS_POR_ROL : dict
  --
  + verificar_permiso(actor_id, permiso, modulo) : dict
  + obtener_matriz_rbac() : dict
}

class Celda {
  + codigo : str <<PK>> [C-01..C-70, M-01..M-10]
  + tipo_permitido : Enum(CARRO, MOTO)
  + estado : Enum(DISPONIBLE, OCUPADA, MANTENIMIENTO, INACTIVA)
  + piso : int
  + zona : str
  + motivo_bloqueo : str
  --
  + crear_celda(datos, usuario_id) : dict
  + cambiar_estado_celda(codigo, estado, motivo, usuario_id) : dict
  + reubicar_vehiculo_celda(placa, nueva_celda, ...) : dict
}

class RegistroAcceso {
  + id : int <<PK>>
  + vehiculo_placa : str <<FK>>
  + celda_codigo : str <<FK>>
  + fecha_ingreso : datetime
  + fecha_salida : datetime
  + estado : Enum(ADENTRO, FINALIZADO)
  + observaciones : str
  + usuario_id : int <<FK>>
  --
  + registrar_ingreso(placa, obs, puerta, usuario_id) : dict
  + registrar_novedad_vehiculo(placa, novedad, usuario_id) : dict
  + registrar_salida(placa, obs, puerta, usuario_id) : dict
}

class HistorialCelda {
  + id : int <<PK>>
  + celda_codigo : str <<FK>>
  + estado_anterior : str
  + estado_nuevo : str
  + motivo : str
  + usuario_id : int <<FK>>
  + fecha_cambio : datetime
}

class Propietario {
  + id : int <<PK>>
  + documento : str <<unique>>
  + nombre_completo : str
  + telefono : str
  + email : str
  + direccion : str
}

class Vehiculo {
  + placa : str <<PK>>
  + tipo_vehiculo : Enum(CARRO, MOTO)
  + marca : str
  + modelo : str
  + color : str
  + propietario_id : int <<FK>>
  + activo : bool
  --
  + consultar_vehiculo(placa) : dict
  + registrar_nuevo_abonado(datos, usuario_id) : dict
  + cancelar_suscripcion_abonado(placa, motivo, usuario_id) : dict
  + reactivar_suscripcion_abonado(datos, usuario_id) : dict
}

class Mensualidad {
  + id : int <<PK>>
  + vehiculo_placa : str <<FK>>
  + fecha_pago : date
  + fecha_vencimiento : date
  + valor_pagado : decimal
  + estado : Enum(ACTIVA, VENCIDA, CANCELADA)
  --
  + calcular_nueva_vigencia(fecha_pago, meses, es_react) : dict
  + esta_al_dia() : bool
}

class Pago #ECFDF5;line:059669 {
  + id : int <<PK>>
  + numero_recibo : str <<unique>>
  + vehiculo_placa : str <<FK>>
  + mensualidad_id : int <<FK>>
  + fecha_pago : date
  + fecha_registro : datetime
  + periodo_inicio : date
  + periodo_fin : date
  + meses_pagados : int
  + valor_pagado : decimal
  + metodo_pago : Enum(EFECTIVO, TRANSFERENCIA_BANCARIA, CODIGO_QR, CONSIGNACION)
  + referencia_comprobante : str
  + tipo_aplicacion : Enum(PAGO_ANTICIPADO, PAGO_PUNTUAL, MORA_CONSECUTIVA, INICIAL_REACTIVACION)
  + estado : Enum(CONFIRMADO, ANULADO)
  + observaciones : str
  + usuario_id : int <<FK>>
  --
  + previsualizar_pago_mensualidad(placa, fecha, meses) : dict
  + registrar_pago_mensualidad(datos, usuario_id) : dict
  + anular_pago(pago_id, motivo, admin_id) : dict
  + obtener_estado_pagos_y_caja(filtros) : dict
  + registrar_alerta_vencimiento(placa, canal, usuario_id) : dict
}

class AuditoriaAccion {
  + id : int <<PK>>
  + usuario_id : int <<FK>>
  + modulo : str
  + accion : str
  + detalle : str
  + ip_terminal : str
  + fecha : datetime
}

Usuario "1" ..> VerificadorRBAC : valida permisos >
Usuario "1" -- "0..*" AuditoriaAccion : registra >
Usuario "1" -- "0..*" HistorialCelda : ejecuta cambio >
Usuario "1" -- "0..*" RegistroAcceso : opera en cabina >
Usuario "1" -- "0..*" Pago : recauda / anula >
Propietario "1" -- "1..*" Vehiculo : posee >
Vehiculo "1" *-- "1..*" Mensualidad : suscribe >
Vehiculo "1" -- "0..*" Pago : liquida >
Vehiculo "1" -- "0..*" RegistroAcceso : protagoniza >
Celda "1" -- "0..*" RegistroAcceso : aloja en >
Celda "1" *-- "0..*" HistorialCelda : registra cambios >
Mensualidad "1" *-- "0..*" Pago : respalda >
@enduml
