@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 6
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam ArrowColor #2C3E50
skinparam ArrowFontColor #1E293B
skinparam ClassBackgroundColor #FFFBEB
skinparam ClassHeaderBackgroundColor #FEF3C7
skinparam ClassBorderColor #B45309

title Diagrama de Clases del Dominio (Módulo de Pagos Integrado) — Iteración 3

class Usuario {
  + id : int <<PK>>
  + username : str <<unique>>
  - password_hash : str [SHA-256]
  + rol : Enum(ADMIN, OPERARIO, AUDITOR)
  + activo : bool
  --
  + autenticar_usuario(username, password) : dict
}

class VerificadorRBAC <<service>> {
  + PERMISOS_POR_ROL : dict
  --
  + verificar_permiso(actor_id, permiso, modulo) : dict
}

class Propietario {
  + id : int <<PK>>
  + documento : str <<unique>>
  + nombre_completo : str
  + telefono : str
  + email : str
}

class Vehiculo {
  + placa : str <<PK>>
  + tipo_vehiculo : Enum(CARRO, MOTO)
  + propietario_id : int <<FK>>
  + activo : bool
  --
  + consultar_vehiculo(placa) : dict
  + cancelar_suscripcion_abonado(placa, motivo, usuario_id) : dict
  + reactivar_suscripcion_abonado(datos, usuario_id) : dict
}

class Mensualidad {
  + id : int <<PK>>
  + vehiculo_placa : str <<FK>>
  + fecha_pago : date
  + fecha_vencimiento : date
  + valor_pagado : decimal
  + estado : Enum(ACTIVA, VENCIDA, CANCELADA)
  --
  + calcular_nueva_vigencia(fecha_pago, meses, es_react) : dict
  + esta_al_dia() : bool
}

class Pago #ECFDF5;line:059669 {
  + id : int <<PK>>
  + numero_recibo : str <<unique>>
  + vehiculo_placa : str <<FK>>
  + mensualidad_id : int <<FK>>
  + fecha_pago : date
  + periodo_inicio : date
  + periodo_fin : date
  + meses_pagados : int
  + valor_pagado : decimal
  + metodo_pago : Enum(EFECTIVO, TRANSFERENCIA, QR, CONSIGNACION)
  + referencia_comprobante : str
  + tipo_aplicacion : Enum(ANTICIPADO, PUNTUAL, MORA, INICIAL)
  + estado : Enum(CONFIRMADO, ANULADO)
  + usuario_id : int <<FK>>
  --
  + previsualizar_pago_mensualidad(placa, fecha, meses) : dict
  + registrar_pago_mensualidad(datos, usuario_id) : dict
  + anular_pago(pago_id, motivo, admin_id) : dict
  + obtener_estado_pagos_y_caja(filtros) : dict
  + registrar_alerta_vencimiento(placa, canal, usuario_id) : dict
}

class AuditoriaAccion {
  + id : int <<PK>>
  + usuario_id : int <<FK>>
  + modulo : str
  + accion : str
  + detalle : str
  + fecha : datetime
}

Usuario "1" ..> VerificadorRBAC : valida permisos >
Propietario "1" -- "1..*" Vehiculo : posee >
Vehiculo "1" *-- "1..*" Mensualidad : suscribe >
Vehiculo "1" -- "0..*" Pago : liquida >
Mensualidad "1" *-- "0..*" Pago : respalda >
Usuario "1" -- "0..*" Pago : recauda / anula >
Usuario "1" -- "0..*" AuditoriaAccion : registra >
@enduml
