{
  "_type": "Project",
  "_id": "PROJ_AUTOS_COLOMBIA_EA1_CORR",
  "name": "Autos Colombia 24/7 - Iteración 1 (Ajustes y Correcciones)",
  "author": "Adriana Andrea Agudelo, Camilo Alberto Palacios, Juan Daniel Pulgarin - Docente: Reinaldo Rojas",
  "version": "1.2 - Corrección Estricta StarUML",
  "ownedElements": [
    {
      "_type": "UMLModel",
      "_id": "MODEL_EA1_CORRECCION",
      "name": "01_Modelo_Casos_de_Uso_7RF_StarUML",
      "ownedElements": [
        {
          "_type": "UMLUseCaseDiagram",
          "_id": "DIAG_UC_7RF",
          "name": "Diagrama_Casos_Uso_7RF_StarUML"
        },
        {
          "_type": "UMLActor",
          "_id": "ACT_OPERARIO",
          "name": "Operario de Cabina (Actor Principal)"
        },
        {
          "_type": "UMLActor",
          "_id": "ACT_LPR",
          "name": "Cámara / Sensor LPR (Actor Secundario)"
        },
        {
          "_type": "UMLActor",
          "_id": "ACT_RELOJ",
          "name": "Reloj del Servidor 24/7 (Actor Secundario)"
        },
        {
          "_type": "UMLUseCase",
          "_id": "UC_01",
          "name": "CU-01: Validar Vehículo por Placa (RF-01)",
          "documentation": "Permite buscar la placa del vehículo al ingresar y verificar su mensualidad activa en el padrón de abonados.",
          "ownedElements": [
            {
              "_type": "UMLInclude",
              "_id": "INC_01_TO_02",
              "source": {
                "": "UC_01"
              },
              "target": {
                "": "UC_02"
              }
            }
          ]
        },
        {
          "_type": "UMLUseCase",
          "_id": "UC_02",
          "name": "CU-02: Visualizar Atributos de Seguridad (RF-02)",
          "documentation": "Muestra al operario placa, tipo de vehículo, marca, modelo, color y conductor registrado para comprobación visual."
        },
        {
          "_type": "UMLUseCase",
          "_id": "UC_03",
          "name": "CU-03: Asignar Celda Aleatoria y Verificar Capacidad (RF-03)",
          "documentation": "Verifica disponibilidad dentro de las 80 celdas (70 carros / 10 motos) y asigna una celda libre al azar cambiando a Ocupada."
        },
        {
          "_type": "UMLUseCase",
          "_id": "UC_04",
          "name": "CU-04: Denegar Ingreso y Bloquear Barrera (RF-04)",
          "documentation": "Bloquea el ingreso y muestra alerta si: placa no existe, mensualidad vencida, sobrecupo o vehículo ya adentro.",
          "ownedElements": [
            {
              "_type": "UMLExtend",
              "_id": "EXT_04_TO_05",
              "name": "si placa inexistente, mora, aforo lleno o duplicidad",
              "source": {
                "": "UC_04"
              },
              "target": {
                "": "UC_05"
              }
            }
          ]
        },
        {
          "_type": "UMLUseCase",
          "_id": "UC_05",
          "name": "CU-05: Registrar Entrada de Vehículo (RF-05)",
          "documentation": "Almacena fecha y hora exacta de entrada vinculando placa con celda asignada y abre barrera.",
          "ownedElements": [
            {
              "_type": "UMLInclude",
              "_id": "INC_05_TO_01",
              "source": {
                "": "UC_05"
              },
              "target": {
                "": "UC_01"
              }
            },
            {
              "_type": "UMLInclude",
              "_id": "INC_05_TO_03",
              "source": {
                "": "UC_05"
              },
              "target": {
                "": "UC_03"
              }
            },
            {
              "_type": "UMLInclude",
              "_id": "INC_05_TO_TIMESTAMP",
              "source": {
                "": "UC_05"
              },
              "target": {
                "": "UC_TIMESTAMP"
              }
            }
          ]
        },
        {
          "_type": "UMLUseCase",
          "_id": "UC_06",
          "name": "CU-06: Registrar Novedad Física del Vehículo (RF-06)",
          "documentation": "Permite asociar una observación o novedad física ocurrida sobre el vehículo durante su ingreso o estancia.",
          "ownedElements": [
            {
              "_type": "UMLExtend",
              "_id": "EXT_06_TO_05",
              "name": "opcional si presenta novedad física",
              "source": {
                "": "UC_06"
              },
              "target": {
                "": "UC_05"
              }
            }
          ]
        },
        {
          "_type": "UMLUseCase",
          "_id": "UC_07",
          "name": "CU-07: Registrar Salida y Liberar Celda (RF-07)",
          "documentation": "Registra fecha y hora de salida, cierra el movimiento activo y cambia inmediatamente la celda a Disponible.",
          "ownedElements": [
            {
              "_type": "UMLInclude",
              "_id": "INC_07_TO_PERMANENCIA",
              "source": {
                "": "UC_07"
              },
              "target": {
                "": "UC_PERMANENCIA"
              }
            }
          ]
        },
        {
          "_type": "UMLUseCase",
          "_id": "UC_TIMESTAMP",
          "name": "Estampar Fecha y Hora de Acceso",
          "documentation": "Sella la marca temporal atómica del ingreso suministrada por el reloj del sistema."
        },
        {
          "_type": "UMLUseCase",
          "_id": "UC_PERMANENCIA",
          "name": "Calcular Tiempo de Permanencia",
          "documentation": "Calcula la duración exacta de estancia entre fecha de ingreso y fecha de salida."
        }
      ]
    },
    {
      "_type": "UMLModel",
      "_id": "MODEL_PAQUETES_STARUML",
