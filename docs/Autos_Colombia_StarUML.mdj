                "": "PKG_DB"
              }
            }
          ]
        },
        {
          "_type": "UMLPackage",
          "_id": "PKG_DB",
          "name": "Capa de Base de Datos Relacional",
          "documentation": "autos_colombia.db con SQLite 3 y foreign keys activas"
        }
      ]
    }
  ]
}