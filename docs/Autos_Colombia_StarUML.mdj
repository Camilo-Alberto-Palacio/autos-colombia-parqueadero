              }
            }
          ]
        },
        {
          "_type": "UMLPackage",
          "_id": "PKG_DOMINIO",
          "name": "Capa de Dominio y Lógica de Negocio",
          "documentation": "models.py con ParqueaderoService, control de aforo y reglas de acceso",
          "ownedElements": [
            {
              "_type": "UMLDependency",
